{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raillersing/agent-visual-bridge/schemas/proposal.schema.json",
  "title": "Visual Bridge proposal input",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "interaction_kind": {
      "enum": [
        "inform",
        "clarify",
        "authorize"
      ]
    },
    "report_type": {
      "enum": [
        "auto",
        "audit",
        "plan",
        "review",
        "decision"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "question": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "consequences": {
          "type": "string"
        },
        "interaction_kind": {
          "enum": [
            "inform",
            "clarify",
            "authorize"
          ]
        },
        "dependencies": {
          "$ref": "#/$defs/strings"
        },
        "unknowns": {
          "$ref": "#/$defs/strings"
        },
        "constraints": {
          "$ref": "#/$defs/strings"
        },
        "options": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "agent_observation",
                  "tool_result",
                  "human_statement",
                  "document"
                ]
              }
            }
          }
        },
        "diff": {
          "type": "string",
          "maxLength": 100000
        },
        "action": {
          "type": "object",
          "required": [
            "operation",
            "scope"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "external": {
              "type": "boolean"
            },
            "reversible": {
              "type": "boolean"
            },
            "required_tools": {
              "$ref": "#/$defs/strings"
            },
            "required_output": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      }
    }
  }
}
